# Replace with Upstash Redis credentials
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=
TRACKER_STORAGE_PREFIX=your_prefix

# Replace with your deployment URL
APP_BASE_URL=http://localhost:3000/

# Generated Web Push keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Replace with your QStash token
QSTASH_TOKEN=

# Generated security secrets
REMINDER_DISPATCH_SECRET=
REQUIRE_TRACKER_TOKEN=1
TRACKER_PRIVATE_TOKEN=

APP_TIMEZONE=Asia/Kolkata

# Supabase is the primary durable database. The anon key is public by design;
# access is constrained by the RLS policies in supabase/schema.sql.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Server only. Add in Vercel; never expose this value in browser JavaScript.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OWNER_ID=your-owner-id
