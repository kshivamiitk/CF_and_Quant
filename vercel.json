{
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/index.py?__wellframe_route=:route*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
